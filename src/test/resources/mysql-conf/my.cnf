[mysqld]
# Make table-name resolution case-insensitive so native queries that spell the
# table as `Feedback` resolve against the `feedback` table on Linux containers,
# matching the behaviour of a typical local (macOS/Windows) MySQL install.
# This option is only honoured at server initialisation, which is exactly when
# Testcontainers first starts the container.
lower_case_table_names=1
